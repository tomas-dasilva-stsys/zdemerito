<mvc:View
    controllerName="zdemerito.controller.DetailView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page
        id="detailPage"
        title="{i18n>detailTitle}"
        navButtonPress=".onNavBack"
        showNavButton="true"
    >
        <!-- Barra de búsqueda y filtro -->
        <subHeader>
            <Bar
                id="searchBar"
                class="sapUiMediumMarginBottom"
            >
                <contentLeft>
                    <Label text="{i18n>search}:" />
                    <SearchField
                        id="searchField"
                        width="15rem"
                        search=".onSearch"
                    />
                </contentLeft>
                <contentRight>
                    <Label text="{i18n>filterBy}:" />
                    <Select
                        id="filterSelect"
                        change=".onFilterChange"
                        items="{/concepts}"
                    >
                        <items>
                            <core:Item
                                key="{key}"
                                text="{text}"
                            />
                        </items>
                    </Select>
                </contentRight>
            </Bar>
        </subHeader>

        <content>
            <Table
                id="piezasTable"
                mode="MultiSelect"
                items="{/piezas}"
                selectionChange="onPiezasTableSelectionChange"
                updateFinished="onPiezasTableUpdateFinished"
                growingScrollToLoad="true"
                growing="true"
                sticky="ColumnHeaders"
            >
                <columns>
                    <!-- Cant. Recup. -->
                    <Column
                        width="7rem"
                        hAlign="Center"
                    >
                        <Text
                            text="{i18n>recoveryQuantity}"
                            wrapping="true"
                        />
                    </Column>

                    <!-- Concepto Clas. -->
                    <Column
                        width="7rem"
                        hAlign="Center"
                    >
                        <Text
                            text="{i18n>conceptClassification}"
                            wrapping="true"
                        />
                    </Column>

                    <!-- Pos -->
                    <Column
                        width="5rem"
                        hAlign="Center"
                    >
                        <Text text="{i18n>position}" />
                    </Column>

                    <!-- Componente -->
                    <Column width="9rem">
                        <Text text="{i18n>component}" />
                    </Column>

                    <!-- Denominación Componente -->
                    <Column
                        minScreenWidth="Tablet"
                        demandPopin="true"
                    >
                        <Text text="{i18n>componentDenomination}" />
                    </Column>

                    <!-- Cantidad -->
                    <Column
                        width="6rem"
                        hAlign="End"
                    >
                        <Text text="{i18n>quantity}" />
                    </Column>

                    <!-- Um -->
                    <Column
                        width="4rem"
                        hAlign="Center"
                    >
                        <Text text="{i18n>unitMeasure}" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <!-- Cant. Recup. input -->
                            <Input
                                value="{recoveryQty}"
                                type="Number"
                                change="onRecoveryQtyInputChange"
                            />

                            <!-- Concepto Clas. -->
                            <Text text="{sortf}" />

                            <!-- Pos -->
                            <Text text="{posnr}" />

                            <!-- Componente -->
                            <Text text="{matnr_2}" />

                            <!-- Denominación Componente -->
                            <Text text="{maktx}" />

                            <!-- Cantidad -->
                            <Text
                                id="idMenge"
                                text="{menge}"
                            />

                            <!-- Um -->
                            <Text text="{meins}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            <HBox
                justifyContent="Center"
                alignItems="Center"
                class="sapUiSmallMarginTop sapUiSmallMarginBottom"
            >
                <Button
                    text="{i18n>loadMoreData}"
                    type="Transparent"
                    visible="{= ${/hasMore} === true &amp;&amp; ${/isLoading} !== true }"
                    press=".onLoadMore"
                />
                <BusyIndicator
                    visible="{/isLoading}"
                    size="50%"
                />
            </HBox>
        </content>

        <footer>
            <Toolbar>
                <Button
                    id="messagePopoverBtn"
                    icon="sap-icon://notification-2"
                    text="{popoverModel>/messageLength}"
                    type="{popoverModel>/type}"
                    press=".handleMessagePopoverPress"
                    ariaHasPopup="Dialog"
                />
                <ToolbarSpacer />
                <Button
                    id="saveButton"
                    text="{i18n>saveButton}"
                    type="Emphasized"
                    enabled="false"
                    press=".onSavePress"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
