<mvc:View
    controllerName="zdemerito.controller.DetailView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page
        id="detailPage"
        title="{i18n>detailTitle}"
        navButtonPress=".onNavBack"
    >
        <!-- Barra de búsqueda y filtro -->
        <subHeader>
            <Bar
                id="searchBar"
                class="sapUiMediumMarginBottom"
            >
                <contentLeft>
                    <Label text="{i18n>search}:" />
                    <SearchField
                        id="searchField"
                        width="15rem"
                        search=".onSearch"
                    />
                </contentLeft>
                <contentRight>
                    <Label text="{i18n>filterBy}:" />
                    <Select
                        id="filterSelect"
                        change=".onFilterChange"
                    >
                        <core:Item
                            key="all"
                            text="Todos los conceptos"
                        />
                        <core:Item
                            key="4050"
                            text="4050"
                        />
                        <core:Item
                            key="4060"
                            text="4060"
                        />
                        <core:Item
                            key="4080"
                            text="4080"
                        />
                    </Select>
                </contentRight>
            </Bar>
        </subHeader>

        <content>
            <Table
                id="piezasTable"
                mode="MultiSelect"
                items="{/piezas}"
                selectionChange="onPiezasTableSelectionChange"
                updateFinished="onPiezasTableUpdateFinished"
                growingScrollToLoad="true"
                growing="true"
                sticky="ColumnHeaders"
            >
                <columns>
                    <!-- Cant. Recup. -->
                    <Column
                        width="7rem"
                        hAlign="Center"
                    >
                        <Text
                            text="Cant. Recup."
                            wrapping="true"
                        />
                    </Column>

                    <!-- Concepto Clas. -->
                    <Column
                        width="7rem"
                        hAlign="Center"
                    >
                        <Text
                            text="Concepto Clas."
                            wrapping="true"
                        />
                    </Column>

                    <!-- Pos -->
                    <Column
                        width="5rem"
                        hAlign="Center"
                    >
                        <Text text="Pos" />
                    </Column>

                    <!-- Componente -->
                    <Column width="9rem">
                        <Text text="Componente" />
                    </Column>

                    <!-- Denominación Componente -->
                    <Column
                        minScreenWidth="Tablet"
                        demandPopin="true"
                    >
                        <Text text="Denominación Componente" />
                    </Column>

                    <!-- Cantidad -->
                    <Column
                        width="6rem"
                        hAlign="End"
                    >
                        <Text text="Cantidad" />
                    </Column>

                    <!-- Um -->
                    <Column
                        width="4rem"
                        hAlign="Center"
                    >
                        <Text text="Um" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <!-- Cant. Recup. input -->
                            <Input
                                value="{menge}"
                                type="Number"
                                change="onMengeInputChange"
                            />

                            <!-- Concepto Clas. -->
                            <Text text="{conceptoClas}" />

                            <!-- Pos -->
                            <Text text="{rspos}" />

                            <!-- Componente -->
                            <Text text="{matnr_2}" />

                            <!-- Denominación Componente -->
                            <Text text="{maktx}" />

                            <!-- Cantidad -->
                            <Text text="{menge}" />

                            <!-- Um -->
                            <Text text="{meins}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            <HBox
                justifyContent="Center"
                alignItems="Center"
                class="sapUiSmallMarginTop sapUiSmallMarginBottom"
            >
                <Button
                    text="{i18n>loadMoreData}"
                    type="Transparent"
                    visible="{= ${/hasMore} === true &amp;&amp; ${/isLoading} !== true }"
                    press=".onLoadMore"
                />
                <BusyIndicator
                    visible="{/isLoading}"
                    size="50%"
                />
            </HBox>
        </content>

        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button
                    id="saveButton"
                    text="{i18n>saveButton}"
                    type="Emphasized"
                    enabled="false"
                    press=".onSavePress"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
