<core:FragmentDefinition
    xmlns:m="sap.m"
    xmlns:core="sap.ui.core"
    xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:fb="sap.ui.comp.filterbar"
>
    <ValueHelpDialog
        id="MaterialHelpDialog"
        title="{i18n>materialLabel}"
        ok=".onValueHelpOkPress"
        cancel="._closeValueHelpDialog"
        key="Material"
        descriptionKey="Name"
        supportMultiselect="false"
    >
        <filterBar>
            <fb:FilterBar search="onValueHelpSearch">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem
                        groupName="__$INTERNAL$"
                        name="matnr"
                        label="{i18n>materialLabel}"
                        visibleInFilterBar="true"
                    >
                        <fb:control>
                            <m:Input
                                name="matnr"
                                submit="onValueHelpSearch"
                            />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem
                        groupName="__$INTERNAL$"
                        name="maktx"
                        label="{i18n>descriptionLabel}"
                        visibleInFilterBar="true"
                    >
                        <fb:control>
                            <m:Input
                                name="maktx"
                                submit="onValueHelpSearch"
                            />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
        </filterBar>
    </ValueHelpDialog>
</core:FragmentDefinition>
