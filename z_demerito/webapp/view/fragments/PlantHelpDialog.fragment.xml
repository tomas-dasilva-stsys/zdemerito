<core:FragmentDefinition
    xmlns:m="sap.m"
    xmlns:core="sap.ui.core"
    xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:fb="sap.ui.comp.filterbar"
>
    <ValueHelpDialog
        id="PlantHelpDialog"
        title="{i18n>plantLabel}"
        ok=".onValueHelpOkPress"
        cancel="._closeValueHelpDialog"
        key="Plant"
        descriptionKey="Name"
        supportMultiselect="false"
    >
        <filterBar>
            <fb:FilterBar search="onValueHelpSearch">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem
                        groupName="__$INTERNAL$"
                        name="werks"
                        label="{i18n>plantLabel}"
                        visibleInFilterBar="true"
                    >
                        <fb:control>
                            <m:Input
                                name="werks"
                                submit="onValueHelpSearch"
                            />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem
                        groupName="__$INTERNAL$"
                        name="name1"
                        label="{i18n>name}"
                        visibleInFilterBar="true"
                    >
                        <fb:control>
                            <m:Input
                                name="name1"
                                submit="onValueHelpSearch"
                            />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
        </filterBar>
    </ValueHelpDialog>
</core:FragmentDefinition>
